{
  "name": "dsh-plot-tools",
  "version": "2.0.0",
  "description": "宿主常驻绘图工具插件：plot_data_chart（学术数据图，PDF 矢量 + PNG 预览 + 数据特征）与 generate_diagram（4 套流程图模板），业务层为独立 Python CLI（plot_plugin.py + plotcore/ + diagram/）。",
  "type": "module",
  "main": "index.js",
  "private": true,
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "plot", "matplotlib", "drawio", "学术绘图", "流程图"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": ["index.js", "plot_plugin.py", "plotcore", "diagram", "cordis.patch.yml", "README.md"],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  }
}
